# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="8xMeetly"

# Supabase — current key names (Supabase dashboard → Connect).
# Legacy ANON_KEY / SERVICE_ROLE_KEY still work as fallback.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Meeting BaaS (v2 API — key starts with `mb-`)
MEETING_BAAS_API_KEY=
MEETING_BAAS_API_URL=https://api.meetingbaas.com
# Optional: SVIX endpoint secret (whsec_...) from the Meeting BaaS dashboard
# webhook settings. When set + svix headers present, deliveries are verified.
MEETING_BAAS_WEBHOOK_SECRET=

# AI (Phase 3 — OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
